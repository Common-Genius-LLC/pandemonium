# Copy to .env and edit. Bun auto-loads .env; never commit the real file.
PORT=8787

# HS256 signing secret for access tokens. Use at least 32 random bytes in prod.
JWT_SECRET=dev-insecure-change-me-0123456789abcdef

# Where the Vite dev server runs, echoed back as the CORS origin (credentials
# are included for the refresh cookie, so this cannot be "*").
CORS_ORIGIN=http://localhost:5173

# Database. Dev defaults to a local SQLite file (zero infrastructure). The driver
# is chosen by the URL scheme (see src/db.ts):
#   sqlite://./pandemonium.dev.sqlite   local file (default)
#   sqlite://:memory:                   ephemeral, for tests
#   postgres://user:pass@host:5432/db   PostgreSQL (prod; `docker compose up -d db`)
DATABASE_URL=sqlite://./pandemonium.dev.sqlite

# Set true when serving over HTTPS across sites (Cloudflare Pages -> OCI). It
# switches the refresh cookie to Secure + SameSite=None. Leave false for local
# http dev.
COOKIE_SECURE=false

# Set true ONLY behind a reverse proxy that sets X-Real-IP from the real peer
# (the nginx config in docs/DEPLOYMENT.md does). The link-preview rate limit is
# per client; without this, behind a proxy, every user shares one bucket.
# Leave false when the API is reachable directly, or clients could pick their
# own address by sending the header.
TRUST_PROXY=false

# GET /v1/link-preview (server/src/link-preview/). Requests per client per
# minute, and the two user agents it tries: a desktop Chrome first, then an
# honestly named bot for sites that only give their Open Graph card to one.
# LINK_PREVIEW_RATE_PER_MINUTE=60
# LINK_PREVIEW_USER_AGENT=
# LINK_PREVIEW_BOT_USER_AGENT=
