# Frontend env (Vite). Copy to .env.local for local overrides. Vite only exposes
# variables prefixed with VITE_ to the client.

# Base URL of the Pandemonium backend API. Defaults to the local dev server if
# unset (see src/data/session.js). In production set this to the deployed API,
# e.g. https://api.pandemonium.app/v1
VITE_API_BASE=http://localhost:8787/v1

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Substituted into the
# gtag loader tag in index.html at build time and read by src/utils/analytics.js.
# Leave empty to disable analytics: every track* call then no-ops. Note that
# when this is unset the loader tag in index.html still requests gtag.js with an
# unsubstituted id, which Google answers with an error. Harmless, but set the
# variable (or drop the tag) for a clean console.
VITE_GA4_MEASUREMENT_ID=
