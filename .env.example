# Frontend env (Vite). Copy to .env.local for local overrides. Vite only exposes
# variables prefixed with VITE_ to the client.

# Base URL of the Pandemonium backend API. Defaults to the local dev server if
# unset (see src/data/session.js). In production set this to the deployed API,
# e.g. https://api.pandemonium.app/v1
VITE_API_BASE=http://localhost:8787/v1

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Substituted into the
# gtag loader tag in index.html at build time and read by src/utils/analytics.js.
# Leave empty to disable analytics: every track* call then no-ops. Note that
# when this is unset the loader tag in index.html still requests gtag.js with an
# unsubstituted id, which Google answers with an error. Harmless, but set the
# variable (or drop the tag) for a clean console.
VITE_GA4_MEASUREMENT_ID=

# Microsoft Clarity project id (src/utils/clarity.js). Leave empty in dev so no
# local session is recorded; production sets it in .env.production.
VITE_CLARITY_PROJECT_ID=

# ---- Beta mode (src/config/beta.js) ----

# The one switch. Leave unset or "true" while in beta. Set to "false" and
# rebuild to remove the corner badge, the bug reporter, the global error
# capture, and the Ctrl-Alt-B shortcut. Because Vite inlines this at build
# time, "false" also drops the beta components out of the bundle entirely.
VITE_BETA_MODE=true

# Shown on the badge and stamped on every bug report, so a report can be tied
# to the build it came from. A short git sha works well. Defaults to "dev".
VITE_APP_VERSION=

# Where a submitted bug report is POSTed as JSON. Any endpoint that accepts a
# JSON body works: your own backend route, a Formspree form, a Slack or Discord
# webhook. Leave empty and the reporter copies the report to the tester's
# clipboard instead, so it still works with nothing set up.
VITE_FEEDBACK_ENDPOINT=

# Only used by that clipboard fallback, to tell the tester where to paste it.
VITE_FEEDBACK_CONTACT=
